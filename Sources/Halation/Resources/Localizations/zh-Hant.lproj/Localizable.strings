/* Heads the list of weights a render will load, in the Compose summary. Means these specific files, not the tab and not the folder. */
"summary.models" = "模型";

"summary.notSelected" = "未選擇";

"summary.problems" = "生成前請確認";

"summary.render" = "本次算圖";

/* Opens the terms as a sheet from Compose, for someone who skipped the welcome dialog. 'Review' rather than 'Accept': the button opens the text, it does not agree on anyone's behalf. */
"summary.reviewLicence" = "查看授權條款";

/* The particular job a checkpoint was trained for — first-frame continuation or reference conditioning. A machine-learning sense, not a to-do item or a queued job. */
"summary.task" = "任務";

/* Names the encoder chosen for this render, in the Compose summary. A particular file; role.textEncoder is the category. */
"summary.textEncoder" = "文字編碼器";

/* Architecture name; left in English. */
"summary.transformer" = "Transformer";

/* Tooltip on the marker beside the column matching the running Mac's memory, in both requirements tables. The marker rounds down, so a machine between two configurations is marked on the smaller one. */
"table.thisMac" = "本機";

"task.fl2va" = "FL2VA — 文字與關鍵格";

"task.fl2va.detail" = "文字轉影片，並可選擇性指定首張與／或末張影格圖片。多數情況用這個。";

"task.ref2va" = "Ref2VA — 參考素材";

"task.ref2va.detail" = "最多可依據 9 張參考圖片、3 段參考影片與 3 段參考音訊生成。";

/* Names the Touch Bar's left-hand item in the Customize Touch Bar sheet. What it holds depends on the screen — mode and seed while composing, stop and hold while rendering — so the label has to stay general. */
"touchbar.controls" = "控制項";

/* Fills the Touch Bar's progress slot when the queue is idle. Keep it short — the strip is about 685 pt wide in total and this shares it. */
"touchbar.idle" = "沒有進行中的算圖";

/* Names the progress item in the Customize Touch Bar sheet, so it is read out of context, with no render beside it to explain it. */
"touchbar.progress" = "進度";
