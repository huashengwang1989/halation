"touchbar.controls" = "控件";

/* Fills the Touch Bar's progress slot when the queue is idle. Keep it short — the strip is about 685 pt wide in total and this shares it. */
"touchbar.idle" = "没有进行中的渲染";

/* Names the progress item in the Customize Touch Bar sheet, so it is read out of context, with no render beside it to explain it. */
"touchbar.progress" = "进度";
